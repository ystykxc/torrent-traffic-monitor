# 复制为 .env 并 chmod 600 后使用；请勿把真实凭据提交到仓库。
# 所有变量都有安全默认值，不创建 .env 也能启动（但会回落到 admin/admin + 强制改密）。

# ---- 首次部署强账号（强烈建议设置，消除 admin/admin 竞速窗口）----
BOOTSTRAP_USERNAME=ptadmin
BOOTSTRAP_PASSWORD=请改成至少6位强密码

# ---- 下载器密码加密主密钥（务必与 data/ 分开备份）----
# 留空则在 data/ 目录自动生成 .secret_key
SECRET_KEY=

# ---- 访问端口与运行身份 ----
WEB_PORT=8080
PUID=1000
PGID=1000

# ---- 反向代理 / 会话 ----
# 只有来自这些 CIDR 的请求才识别 X-Forwarded-For；留空 = 不信任任何代理
TRUSTED_PROXIES=
SESSION_BIND=1
SESSION_TTL_DAYS=30
SESSION_MAX_LIFETIME_DAYS=90

# ---- 其他 ----
ALLOW_PRIVATE_TARGETS=1
TZ_OFFSET=8
POLL_INTERVAL=5
TRAFFIC_INTERVAL=60
SAMPLE_RETENTION_DAYS=7
